# Copie para .env.local e preencha. Nunca coloque a service_role key no frontend.
# Sem estas variáveis a aplicação arranca em modo DEMONSTRAÇÃO (dados em memória, não persistidos).
VITE_SUPABASE_URL=https://SEU-PROJECTO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_ANON_PUBLICA
# Força o modo de demonstração mesmo com Supabase configurado (apenas para desenvolvimento)
# VITE_FORCE_DEMO=true
